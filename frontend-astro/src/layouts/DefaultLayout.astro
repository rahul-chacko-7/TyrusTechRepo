---
import Header from '../components/Header.astro';
import '../styles/global.css';
import { site, hasAddress, telLink, whatsappLink } from '../data/site';

const {
  title = 'Document Digitization Services India | Go Green & Secure',
  description = 'Document digitization services across India with secure handling of sensitive data, sustainability-focused workflows, and high-speed scanning.',
  image = '/tyrus-og-image.webp',
  canonical,
  noindex = false,
  schemas = []
} = Astro.props;

const configuredSiteUrl = (import.meta.env.PUBLIC_SITE_URL || Astro.site?.toString() || 'https://www.tyrustech.com').replace(/\/$/, '');
const siteUrl = configuredSiteUrl.replace('https://tyrustech.com', 'https://www.tyrustech.com');
const canonicalUrl = new URL(canonical || Astro.url.pathname, siteUrl).toString();
const imageUrl = image.startsWith('http') ? image : new URL(image, siteUrl).toString();
const publishedSchemas = schemas.filter((schema) => schema?.['@type'] !== 'FAQPage');
const jsonLdSchemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': `${siteUrl}/#organization`,
    name: site.name,
    alternateName: site.shortName,
    url: siteUrl,
    logo: new URL('/tyrus-logo.png', siteUrl).toString(),
    description,
    email: site.email,
    telephone: site.phoneDisplay,
    foundingDate: site.foundingYear,
    sameAs: [...site.sameAs],
    contactPoint: [
      {
        '@type': 'ContactPoint',
        telephone: site.phoneDisplay,
        email: site.email,
        contactType: 'sales',
        areaServed: 'IN',
        availableLanguage: ['en', 'hi']
      }
    ],
    areaServed: {
      '@type': 'Country',
      name: 'India'
    }
  },
  ...(hasAddress
    ? [
        {
          '@context': 'https://schema.org',
          '@type': 'ProfessionalService',
          '@id': `${siteUrl}/#business`,
          name: site.name,
          url: `${siteUrl}/`,
          image: new URL('/tyrus-og-image.webp', siteUrl).toString(),
          logo: new URL('/tyrus-logo.png', siteUrl).toString(),
          telephone: site.phoneDisplay,
          email: site.email,
          foundingDate: site.foundingYear,
          openingHours: site.openingHours,
          address: { '@type': 'PostalAddress', ...site.address },
          areaServed: { '@type': 'Country', name: 'India' },
          parentOrganization: { '@id': `${siteUrl}/#organization` },
          sameAs: [...site.sameAs]
        }
      ]
    : []),
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'Tyrus Technologies',
    url: siteUrl,
    publisher: {
      '@type': 'Organization',
      name: 'Tyrus Technologies Pvt Ltd',
      url: siteUrl
    },
    potentialAction: {
      '@type': 'SearchAction',
      target: `${siteUrl}/blog?search={search_term_string}`,
      'query-input': 'required name=search_term_string'
    }
  },
  ...publishedSchemas
];
/** GA4 measurement ID: Vercel `PUBLIC_GA_MEASUREMENT_ID` or default below (must match Google stream). */
const gaMeasurementId = String(import.meta.env.PUBLIC_GA_MEASUREMENT_ID || 'G-ZMLEXVR9ZB').trim();
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
  <head>
    <!-- Google tag (gtag.js) — same as Google manual install; `define:vars` only wires Vercel PUBLIC_GA_MEASUREMENT_ID -->
    {gaMeasurementId ? (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${gaMeasurementId}`}></script>
        <script is:inline define:vars={{ gaMeasurementId }}>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          // define:vars wraps this script in a function; expose gtag so site-wide lead and click events can use it.
          window.gtag = gtag;
          gtag('js', new Date());

          gtag('config', gaMeasurementId);
        </script>
      </>
    ) : null}
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large'} />
    <meta name="theme-color" content="#047857" />
    <meta name="google-site-verification" content="d3IOP12jDpQPkdQyH0hf5xijhtu62q4Ky0wjBVLXJks" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://www.googletagmanager.com" crossorigin />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Tyrus Technologies" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Tyrus Technologies document scanning and digitization services" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content="Tyrus Technologies document scanning and digitization services" />

    {jsonLdSchemas.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)}></script>
    ))}
  </head>
  <body class="min-h-screen pb-16 md:pb-0 bg-gradient-to-b from-emerald-50 via-slate-50 to-slate-100 text-slate-900">
    <div class="flex min-h-screen flex-col">
      <Header />
      <main class="flex-1">
        <slot />
      </main>
      <footer class="border-t border-emerald-100 bg-white/90">
        <div class="mx-auto max-w-6xl px-4 py-6 text-sm text-slate-500">
          <div class="grid gap-5 border-b border-slate-200 pb-5 md:grid-cols-4">
            <div>
              <p class="font-semibold text-slate-800">Contact Tyrus</p>
              <div class="mt-2 flex flex-col gap-1">
                <a href={telLink} class="font-semibold text-emerald-700 hover:text-emerald-800">Call {site.phoneDisplay}</a>
                <a href={whatsappLink} target="_blank" rel="noopener" class="hover:text-emerald-700">WhatsApp {site.whatsappDisplay}</a>
                <a href={`mailto:${site.email}`} class="hover:text-emerald-700">{site.email}</a>
                <span>{site.openingHoursDisplay}</span>
                {hasAddress && (
                  <address class="not-italic">
                    {site.name}<br />{site.address.streetAddress}<br />{site.address.addressLocality}{site.address.postalCode ? ` – ${site.address.postalCode}` : ''}, {site.address.addressRegion}, India
                  </address>
                )}
              </div>
            </div>
            <div>
              <p class="font-semibold text-slate-800">Popular services</p>
              <div class="mt-2 flex flex-col gap-1">
                <a href="/document-scanning-services-india" class="hover:text-emerald-700">Document scanning services in India</a>
                <a href="/document-digitization-services" class="hover:text-emerald-700">Document digitization services</a>
                <a href="/bulk-document-scanning-services" class="hover:text-emerald-700">Bulk document scanning services</a>
                <a href="/onsite-document-scanning-services" class="hover:text-emerald-700">Onsite document scanning services</a>
                <a href="/project-planning" class="hover:text-emerald-700">Project planning and deliverables</a>
              </div>
            </div>
            <div>
              <p class="font-semibold text-slate-800">Specialized scanning</p>
              <div class="mt-2 flex flex-col gap-1">
                <a href="/ocr-indexing-services" class="hover:text-emerald-700">OCR indexing services</a>
                <a href="/ai-document-scanning-services-india" class="hover:text-emerald-700">AI document scanning services</a>
                <a href="/medical-records-scanning-services" class="hover:text-emerald-700">Medical records scanning services</a>
                <a href="/legal-document-scanning-services" class="hover:text-emerald-700">Legal document scanning services</a>
                <a href="/hr-document-scanning-services-india" class="hover:text-emerald-700">HR document scanning services</a>
              </div>
            </div>
            <div>
              <p class="font-semibold text-slate-800">Service areas</p>
              <div class="mt-2 flex flex-col gap-1">
                <a href="/locations/bangalore/document-scanning-services" class="hover:text-emerald-700">Document scanning in Bangalore</a>
                <a href="/locations/delhi-ncr/document-scanning-services" class="hover:text-emerald-700">Document scanning in Delhi</a>
                <a href="/locations/mumbai/document-scanning-services" class="hover:text-emerald-700">Document scanning in Mumbai</a>
                <a href="/locations" class="hover:text-emerald-700">All service locations</a>
              </div>
            </div>
          </div>
          <div class="flex flex-col gap-2 pt-5 md:flex-row md:items-center md:justify-between">
            <p>&copy; {new Date().getFullYear()} Tyrus Technologies Pvt Ltd. Document scanning and digitization since {site.foundingYear}.</p>
            <p>Digitize. Secure. Go Green.</p>
          </div>
        </div>
      </footer>
    </div>

    <!-- Mobile sticky contact bar -->
    <div class="fixed inset-x-0 bottom-0 z-40 grid grid-cols-3 border-t border-emerald-200 bg-white/95 text-center text-xs font-semibold shadow-[0_-4px_16px_rgba(15,23,42,0.08)] backdrop-blur md:hidden" data-sticky-cta>
      <a href={telLink} class="flex flex-col items-center gap-0.5 py-2.5 text-emerald-800">
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h2.3a1 1 0 01.95.68l1.1 3.3a1 1 0 01-.5 1.2l-1.7.85a11 11 0 005.8 5.8l.85-1.7a1 1 0 011.2-.5l3.3 1.1a1 1 0 01.68.95V19a2 2 0 01-2 2h-1C9.7 21 3 14.3 3 6V5z"/></svg>
        Call
      </a>
      <a href={whatsappLink} target="_blank" rel="noopener" class="flex flex-col items-center gap-0.5 border-x border-emerald-100 py-2.5 text-emerald-800">
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 00-8.6 15.1L2 22l5-1.3A10 10 0 1012 2zm0 18.2a8.2 8.2 0 01-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1112 20.2zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8s-.4-.1-.6.1-.7.8-.8 1-.3.2-.5.1a6.7 6.7 0 01-2-1.2 7.4 7.4 0 01-1.4-1.7c-.1-.2 0-.4.1-.5l.4-.4.2-.4v-.4l-.8-1.9c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 00-.7.3 3 3 0 00-.9 2.2 5.2 5.2 0 001.1 2.7 11.8 11.8 0 004.5 4c2.2.9 2.2.6 2.6.6a2.2 2.2 0 001.5-1 1.8 1.8 0 00.1-1c-.1-.1-.2-.2-.5-.3z"/></svg>
        WhatsApp
      </a>
      <a href="/contact" data-track-cta class="flex flex-col items-center gap-0.5 bg-emerald-600 py-2.5 text-white">
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6M7 3h7l5 5v11a2 2 0 01-2 2H7a2 2 0 01-2-2V5a2 2 0 012-2z"/></svg>
        Free quote
      </a>
    </div>

    <!-- Desktop floating WhatsApp -->
    <a href={whatsappLink} target="_blank" rel="noopener" aria-label="Chat with Tyrus on WhatsApp" class="fixed bottom-6 right-6 z-40 hidden items-center gap-2 rounded-full bg-emerald-600 px-5 py-3 text-sm font-semibold text-white shadow-lg shadow-emerald-900/30 transition hover:bg-emerald-700 md:inline-flex">
      <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 00-8.6 15.1L2 22l5-1.3A10 10 0 1012 2zm0 18.2a8.2 8.2 0 01-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1112 20.2z"/></svg>
      WhatsApp for a quote
    </a>

    <script>
      import '../scripts/site.ts';
    </script>
  </body>
</html>
