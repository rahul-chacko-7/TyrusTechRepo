---
import DefaultLayout from './DefaultLayout.astro';

const { frontmatter, url } = Astro.props;
const pageTitle = frontmatter.seoTitle ?? frontmatter.title;
const pageDescription = frontmatter.seoDescription ?? frontmatter.excerpt ?? '';
const image = frontmatter.image ?? '/tyrus-og-image.webp';
const articlePath = typeof url === 'string' ? url : url?.pathname ?? '';
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: frontmatter.title,
  description: pageDescription,
  datePublished: frontmatter.date,
  dateModified: frontmatter.date,
  mainEntityOfPage: `https://www.tyrustech.com${articlePath}`,
  image: 'https://www.tyrustech.com/tyrus-og-image.webp',
  author: {
    '@type': 'Organization',
    name: 'Tyrus Technologies Pvt Ltd',
    url: 'https://www.tyrustech.com'
  },
  publisher: {
    '@type': 'Organization',
    name: 'Tyrus Technologies Pvt Ltd',
    url: 'https://www.tyrustech.com',
    logo: {
      '@type': 'ImageObject',
      url: 'https://www.tyrustech.com/tyrus-og-image.webp'
    }
  }
};
---

<DefaultLayout title={pageTitle} description={pageDescription} image={image} schemas={[articleSchema]}>
  <section class="bg-slate-950 border-b border-slate-800">
    <div class="mx-auto max-w-5xl px-4 py-14 space-y-8">
      <div class="space-y-3">
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-emerald-300">
          {frontmatter.category ?? 'Insight'}
        </p>
        <h1 class="text-3xl font-semibold text-slate-50">
          {frontmatter.title}
        </h1>
        {frontmatter.excerpt && (
          <p class="max-w-2xl text-sm text-slate-300">
            {frontmatter.excerpt}
          </p>
        )}
        <p class="text-xs text-slate-400">
          {frontmatter.date && new Date(frontmatter.date).toLocaleDateString('en-IN', {
            day: '2-digit',
            month: 'short',
            year: 'numeric'
          })}
        </p>
      </div>

      <div class="overflow-hidden rounded-2xl border border-slate-800 bg-slate-900/60">
        {frontmatter.image ? (
          <img
            src={frontmatter.image}
            alt={frontmatter.title}
            class="h-56 w-full object-cover sm:h-72"
            loading="lazy"
          />
        ) : (
          <div class="h-40 w-full bg-gradient-to-r from-emerald-500/30 via-sky-500/20 to-slate-900" />
        )}
      </div>
    </div>
  </section>

  <section class="bg-slate-950">
    <div class="mx-auto max-w-3xl px-4 pb-16">
      <article class="prose prose-sm prose-invert prose-emerald max-w-none">
        <slot />
      </article>
    </div>
  </section>

  <section class="border-t border-slate-800 bg-slate-950">
    <div class="mx-auto max-w-3xl px-4 py-10">
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-emerald-300">Continue planning</p>
      <h2 class="mt-2 text-xl font-semibold text-slate-50">Related document digitization services</h2>
      <div class="mt-5 grid gap-3 sm:grid-cols-2">
        <a href="/document-digitization-services" class="rounded-2xl border border-slate-800 bg-slate-900/70 p-4 transition hover:border-emerald-400">
          <span class="text-sm font-semibold text-slate-50">Document digitization services in India</span>
          <span class="mt-1 block text-xs leading-5 text-slate-400">End-to-end scanning, OCR, indexing and digital archive conversion.</span>
        </a>
        <a href="/document-scanning-services-india" class="rounded-2xl border border-slate-800 bg-slate-900/70 p-4 transition hover:border-emerald-400">
          <span class="text-sm font-semibold text-slate-50">Document scanning services</span>
          <span class="mt-1 block text-xs leading-5 text-slate-400">Bulk, onsite and records scanning for offices and archive rooms.</span>
        </a>
        <a href="/ocr-indexing-services" class="rounded-2xl border border-slate-800 bg-slate-900/70 p-4 transition hover:border-emerald-400">
          <span class="text-sm font-semibold text-slate-50">OCR and document indexing</span>
          <span class="mt-1 block text-xs leading-5 text-slate-400">Searchable PDFs, metadata capture and DMS-ready output.</span>
        </a>
        <a href="/contact" class="rounded-2xl border border-slate-800 bg-slate-900/70 p-4 transition hover:border-emerald-400">
          <span class="text-sm font-semibold text-slate-50">Request a project review</span>
          <span class="mt-1 block text-xs leading-5 text-slate-400">Share volume, location, record type and required output.</span>
        </a>
      </div>
    </div>
  </section>
</DefaultLayout>
