---
import DefaultLayout from '../layouts/DefaultLayout.astro';
import LeadForm from '../components/LeadForm.astro';
import { site, hasAddress, mailLink, whatsappLink } from '../data/site';

const pageTitle = 'Contact Tyrus Technologies | Document Scanning Quote';
const pageDescription = `Get a document scanning quote from Tyrus Technologies. WhatsApp or email us, or send your page count and we reply within one working day.`;
const contactSchema = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: pageTitle,
  url: 'https://www.tyrustech.com/contact',
  mainEntity: { '@id': 'https://www.tyrustech.com/#organization' }
};
---

<DefaultLayout title={pageTitle} description={pageDescription} schemas={[contactSchema]}>
  <section class="border-b border-slate-200 bg-white">
    <div class="mx-auto max-w-6xl px-4 py-12">
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-emerald-700">Contact</p>
      <h1 class="mt-2 text-3xl font-semibold text-slate-900">Talk to Tyrus about your scanning project</h1>
      <p class="mt-3 max-w-3xl text-sm leading-7 text-slate-700">
        Tell us roughly how many pages you have, what kind of records they are and where they are kept. A project lead will come back within one working day with a per-page price, timeline and the best way to run the job: onsite at your premises or at our scanning centre.
      </p>
    </div>
  </section>

  <section class="bg-slate-50">
    <div class="mx-auto grid max-w-6xl gap-8 px-4 py-12 md:grid-cols-[minmax(0,1.3fr),minmax(0,0.8fr)]">
      <LeadForm formId="contact-form" heading="Request a quote or free document audit" context="Contact page" />

      <div class="space-y-6">
        <div class="rounded-2xl bg-white p-6 ring-1 ring-slate-200">
          <h2 class="text-base font-semibold text-slate-900">Reach us directly</h2>
          <dl class="mt-4 space-y-4 text-sm text-slate-800">
            <div>
              <dt class="text-xs font-medium uppercase tracking-wide text-slate-500">WhatsApp</dt>
              <dd><a href={whatsappLink} target="_blank" rel="noopener" class="text-lg font-semibold text-emerald-700">{site.whatsappDisplay}</a></dd>
            </div>
            <div>
              <dt class="text-xs font-medium uppercase tracking-wide text-slate-500">Email</dt>
              <dd><a href={mailLink} class="text-lg font-semibold text-emerald-700">{site.email}</a></dd>
            </div>
            <div>
              <dt class="text-xs font-medium uppercase tracking-wide text-slate-500">Hours</dt>
              <dd>{site.openingHoursDisplay}</dd>
            </div>
            {hasAddress && (
              <div>
                <dt class="text-xs font-medium uppercase tracking-wide text-slate-500">Registered office</dt>
                <dd>
                  <address class="not-italic">
                    {site.name}<br />{site.address.streetAddress}<br />{site.address.addressLocality}{site.address.postalCode ? ` – ${site.address.postalCode}` : ''}, {site.address.addressRegion}, India
                  </address>
                </dd>
              </div>
            )}
          </dl>
        </div>
        <div class="rounded-2xl bg-white p-6 ring-1 ring-slate-200">
          <h2 class="text-base font-semibold text-slate-900">What helps us quote faster</h2>
          <ul class="mt-3 space-y-2 text-sm text-slate-700">
            <li>• Approximate page count, or number of boxes or files</li>
            <li>• Record type: medical, HR, KYC, legal, government, mixed</li>
            <li>• City and whether files can leave your premises</li>
            <li>• OCR, indexing fields and output format you need</li>
            <li>• Deadline</li>
          </ul>
        </div>
      </div>
    </div>
  </section>
</DefaultLayout>
