---
import { site, whatsappLink, mailLink } from '../data/site';

interface Props {
  formId: string;
  heading?: string;
  subheading?: string;
  context?: string;
  theme?: 'light' | 'dark';
}

const {
  formId,
  heading = 'Get a per-page quote within 24 hours',
  subheading = 'Tell us roughly how many pages you have and where they are. A project lead will call you back with a price and timeline.',
  context = '',
  theme = 'light'
} = Astro.props;

const dark = theme === 'dark';
const wrap = dark
  ? 'rounded-3xl bg-slate-900/80 p-6 ring-1 ring-emerald-500/40 sm:p-8'
  : 'rounded-3xl bg-white p-6 shadow-xl shadow-emerald-900/5 ring-1 ring-emerald-200 sm:p-8';
const h = dark ? 'text-slate-50' : 'text-slate-900';
const sub = dark ? 'text-slate-300' : 'text-slate-600';
const label = dark ? 'text-slate-300' : 'text-slate-700';
const input = dark
  ? 'block w-full rounded-lg border border-slate-700 bg-slate-950 px-3 py-2.5 text-sm text-slate-50 outline-none placeholder:text-slate-500 focus:border-emerald-400 focus:ring-2 focus:ring-emerald-500/40'
  : 'block w-full rounded-lg border border-slate-300 bg-white px-3 py-2.5 text-sm text-slate-900 outline-none placeholder:text-slate-400 focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/30';
const note = dark ? 'text-slate-400' : 'text-slate-500';
---

<div class={wrap} data-lead-form-wrap>
  <h2 class={`text-xl font-semibold sm:text-2xl ${h}`}>{heading}</h2>
  <p class={`mt-2 text-sm leading-6 ${sub}`}>{subheading}</p>

  <form id={formId} class="mt-5 space-y-4" data-lead-form data-context={context} novalidate>
    <div class="grid gap-4 sm:grid-cols-2">
      <div>
        <label for={`${formId}-name`} class={`mb-1 block text-xs font-medium ${label}`}>Name *</label>
        <input id={`${formId}-name`} name="name" required autocomplete="name" class={input} placeholder="Your full name" />
      </div>
      <div>
        <label for={`${formId}-phone`} class={`mb-1 block text-xs font-medium ${label}`}>Phone *</label>
        <input id={`${formId}-phone`} name="phone" type="tel" required autocomplete="tel" inputmode="tel" class={input} placeholder="+91 98xxx xxxxx" />
      </div>
      <div>
        <label for={`${formId}-email`} class={`mb-1 block text-xs font-medium ${label}`}>Work email *</label>
        <input id={`${formId}-email`} name="email" type="email" required autocomplete="email" class={input} placeholder="you@company.com" />
      </div>
      <div>
        <label for={`${formId}-company`} class={`mb-1 block text-xs font-medium ${label}`}>Organisation</label>
        <input id={`${formId}-company`} name="company" autocomplete="organization" class={input} placeholder="Hospital, bank, company…" />
      </div>
      <div>
        <label for={`${formId}-city`} class={`mb-1 block text-xs font-medium ${label}`}>City</label>
        <input id={`${formId}-city`} name="city" autocomplete="address-level2" class={input} placeholder="Where are the files?" />
      </div>
      <div>
        <label for={`${formId}-pages`} class={`mb-1 block text-xs font-medium ${label}`}>Approx. pages</label>
        <input id={`${formId}-pages`} name="pages" type="number" min="0" inputmode="numeric" class={input} placeholder="e.g. 50000" />
      </div>
    </div>
    <div>
      <label for={`${formId}-message`} class={`mb-1 block text-xs font-medium ${label}`}>What do you need scanned?</label>
      <textarea id={`${formId}-message`} name="message" rows="3" class={input} placeholder="Record type, onsite or offsite, OCR/indexing needs, deadline"></textarea>
    </div>
    <div class="hidden" aria-hidden="true">
      <label>Leave this empty <input name="website" tabindex="-1" autocomplete="off" /></label>
    </div>
    <p class="text-xs text-rose-500" data-lead-error role="alert"></p>
    <p class="hidden rounded-lg bg-emerald-50 p-3 text-sm text-emerald-800 ring-1 ring-emerald-200" data-lead-success role="status"></p>
    <div class="flex flex-col gap-3 sm:flex-row sm:items-center">
      <button type="submit" class="inline-flex items-center justify-center rounded-full bg-emerald-600 px-6 py-3 text-sm font-semibold text-white shadow-md shadow-emerald-600/30 transition hover:bg-emerald-700 disabled:opacity-60">
        Get my quote
      </button>
      <p class={`text-xs ${note}`}>
        Prefer to chat? <a href={whatsappLink} class="font-semibold text-emerald-600 underline" target="_blank" rel="noopener">WhatsApp us</a> or
        email <a href={mailLink} class="font-semibold text-emerald-600 underline">{site.email}</a>.
      </p>
    </div>
    <p class={`text-[11px] ${note}`}>We use your details only to reply to this request. No spam, no sharing.</p>
  </form>
</div>
