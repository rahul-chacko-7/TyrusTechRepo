---
import DefaultLayout from '../layouts/DefaultLayout.astro';
import LeadForm from './LeadForm.astro';
import { pricingTiers } from '../data/site';

const {
  title,
  description,
  eyebrow,
  h1,
  intro,
  canonical,
  serviceType,
  primaryItems = [],
  process = [],
  industries = [],
  outputs = [],
  faqs = [],
  trustItems = [],
  costFactors = [],
  relatedLinks = [],
  answerSummary = intro,
  headings = {},
  extraSections = [],
  showPriceTable = false,
  noindex = false
} = Astro.props;

const hd = {
  handles: 'What Tyrus handles',
  outputs: 'Typical outputs',
  workflow: 'Project workflow',
  trust: 'Built for confidential records',
  cost: 'What affects project pricing',
  related: 'Related services and guides',
  industries: 'Industries and records covered',
  faq: 'Frequently asked questions',
  price: 'Indicative price per page',
  form: 'Get a per-page quote within 24 hours',
  ...headings
};
const inr = (n: number) => n.toLocaleString('en-IN', { maximumFractionDigits: 2 });
const formId = `lead-${(canonical || 'page').replace(/[^a-z0-9]+/gi, '-').replace(/^-|-$/g, '') || 'page'}`;

const faqSchema = faqs.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faqs.map(([question, answer]) => ({
        '@type': 'Question',
        name: question,
        acceptedAnswer: {
          '@type': 'Answer',
          text: answer
        }
      }))
    }
  : null;

const pageSchemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: title,
    description,
    url: `https://www.tyrustech.com${canonical}`,
    about: [h1, serviceType],
    mainEntity: {
      '@type': 'Service',
      name: serviceType,
      provider: {
        '@type': 'Organization',
        name: 'Tyrus Technologies Pvt Ltd',
        url: 'https://www.tyrustech.com'
      }
    }
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'Home',
        item: 'https://www.tyrustech.com/'
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: h1,
        item: `https://www.tyrustech.com${canonical}`
      }
    ]
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: h1,
    serviceType,
    provider: {
      '@type': 'Organization',
      name: 'Tyrus Technologies Pvt Ltd',
      url: 'https://www.tyrustech.com'
    },
    url: `https://www.tyrustech.com${canonical}`,
    areaServed: {
      '@type': 'Country',
      name: 'India'
    },
    description
  },
  ...(faqSchema ? [faqSchema] : [])
];
---

<DefaultLayout title={title} description={description} canonical={canonical} schemas={pageSchemas} noindex={noindex}>
  <section class="relative overflow-hidden border-b border-emerald-100 bg-gradient-to-b from-emerald-950 via-emerald-900 to-emerald-800">
    <div class="absolute inset-0">
      <picture class="block h-full w-full">
        <source srcset="/hero-scanner-bg-1200.avif" type="image/avif" />
        <source srcset="/hero-scanner-bg-1200.webp" type="image/webp" />
        <img src="/hero-scanner-bg.png" alt="" width="1200" height="800" class="h-full w-full object-cover opacity-20" loading="eager" decoding="async" />
      </picture>
      <div class="absolute inset-0 bg-gradient-to-r from-emerald-950/95 via-emerald-900/85 to-emerald-800/70"></div>
    </div>
    <div class="relative mx-auto grid max-w-6xl gap-8 px-4 py-14 md:grid-cols-[1.15fr,0.85fr] md:items-center md:py-20">
      <div>
        <p class="inline-flex rounded-full border border-emerald-300/40 bg-emerald-800/70 px-3 py-1 text-xs font-semibold text-emerald-100">
          {eyebrow}
        </p>
        <h1 class="mt-5 text-balance text-3xl font-semibold tracking-tight text-white sm:text-4xl md:text-5xl">
          {h1}
        </h1>
        <p class="mt-5 max-w-3xl text-sm leading-7 text-emerald-50/90 sm:text-base">
          {intro}
        </p>
        <div class="mt-6 flex flex-wrap gap-3">
          <a href="#quote" data-track-cta class="rounded-full bg-emerald-400 px-6 py-2 text-sm font-semibold text-emerald-950 shadow-lg shadow-emerald-950/30 hover:bg-white">
            Get a free quote
          </a>
          <a href="/contact" class="rounded-full border border-emerald-200/70 px-6 py-2 text-sm font-semibold text-emerald-50 hover:bg-emerald-700/70">
            Talk to an expert
          </a>
        </div>
      </div>
      <div class="rounded-3xl border border-emerald-200/30 bg-emerald-950/55 p-5 shadow-2xl shadow-emerald-950/50">
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-emerald-200">Why this matters</p>
        <ul class="mt-5 space-y-3 text-sm text-emerald-50">
          {primaryItems.map((item) => (
            <li class="rounded-2xl bg-white/10 p-4">{item}</li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="border-b border-slate-200 bg-white" aria-label="Quick answer">
    <div class="mx-auto max-w-6xl px-4 py-8">
      <p class="max-w-4xl text-base leading-8 text-slate-800">
        <strong>{serviceType}:</strong> {answerSummary}
      </p>
    </div>
  </section>

  <section class="border-b border-slate-200 bg-white">
    <div class="mx-auto grid max-w-6xl gap-8 px-4 py-14 md:grid-cols-[1.05fr,0.95fr]">
      <div>
        <h2 class="text-2xl font-semibold text-slate-900">{hd.handles}</h2>
        <ul class="mt-5 space-y-3 text-sm leading-6 text-slate-800">
          {primaryItems.map((item) => (
            <li class="flex gap-3">
              <span class="mt-2 h-1.5 w-1.5 flex-none rounded-full bg-emerald-500"></span>
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </div>
      <div class="rounded-3xl bg-slate-50 p-6 ring-1 ring-slate-200">
        <h2 class="text-xl font-semibold text-slate-900">{hd.outputs}</h2>
        <ul class="mt-5 space-y-3 text-sm leading-6 text-slate-800">
          {outputs.map((item) => (
            <li class="flex gap-3">
              <span class="mt-2 h-1.5 w-1.5 flex-none rounded-full bg-sky-500"></span>
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="border-b border-slate-200 bg-slate-50">
    <div class="mx-auto max-w-6xl px-4 py-14">
      <h2 class="text-2xl font-semibold text-slate-900">{hd.workflow}</h2>
      <div class="mt-6 grid gap-4 md:grid-cols-4">
        {process.map(([step, text], index) => (
          <article class="rounded-2xl bg-white p-5 ring-1 ring-slate-200">
            <div class="flex h-9 w-9 items-center justify-center rounded-full bg-emerald-600 text-sm font-semibold text-white">{index + 1}</div>
            <h3 class="mt-4 text-sm font-semibold text-slate-900">{step}</h3>
            <p class="mt-2 text-xs leading-6 text-slate-700">{text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  {(trustItems.length || costFactors.length || relatedLinks.length) && (
    <section class="border-b border-slate-200 bg-white">
      <div class="mx-auto grid max-w-6xl gap-6 px-4 py-14 lg:grid-cols-3">
        {trustItems.length > 0 && (
          <div>
            <p class="text-xs font-semibold uppercase tracking-[0.2em] text-emerald-700">Security and proof</p>
            <h2 class="mt-2 text-xl font-semibold text-slate-900">{hd.trust}</h2>
            <ul class="mt-5 space-y-3 text-sm leading-6 text-slate-700">
              {trustItems.map((item) => (
                <li class="rounded-2xl bg-slate-50 p-4 ring-1 ring-slate-200">{item}</li>
              ))}
            </ul>
          </div>
        )}

        {costFactors.length > 0 && (
          <div>
            <p class="text-xs font-semibold uppercase tracking-[0.2em] text-sky-700">Cost planning</p>
            <h2 class="mt-2 text-xl font-semibold text-slate-900">{hd.cost}</h2>
            <ul class="mt-5 space-y-3 text-sm leading-6 text-slate-700">
              {costFactors.map((item) => (
                <li class="rounded-2xl bg-slate-50 p-4 ring-1 ring-slate-200">{item}</li>
              ))}
            </ul>
          </div>
        )}

        {relatedLinks.length > 0 && (
          <div>
            <p class="text-xs font-semibold uppercase tracking-[0.2em] text-slate-600">Next pages</p>
            <h2 class="mt-2 text-xl font-semibold text-slate-900">{hd.related}</h2>
            <div class="mt-5 space-y-3">
              {relatedLinks.map(([label, href, text]) => (
                <a href={href} class="block rounded-2xl bg-slate-50 p-4 ring-1 ring-slate-200 transition hover:ring-emerald-300">
                  <span class="text-sm font-semibold text-slate-900">{label}</span>
                  <span class="mt-1 block text-xs leading-5 text-slate-600">{text}</span>
                </a>
              ))}
            </div>
          </div>
        )}
      </div>
    </section>
  )}

  {showPriceTable && (
    <section class="border-b border-slate-200 bg-slate-50">
      <div class="mx-auto max-w-6xl px-4 py-14">
        <h2 class="text-2xl font-semibold text-slate-900">{hd.price}</h2>
        <p class="mt-3 max-w-3xl text-sm leading-7 text-slate-700">
          Base scanning rates for clean, loose A4 and legal-size paper with standard image clean-up and PDF output. OCR, detailed indexing, onsite deployment, bound or fragile records and urgent deadlines are quoted on top after a short file review.
        </p>
        <div class="mt-6 overflow-x-auto rounded-2xl ring-1 ring-slate-200">
          <table class="w-full min-w-[32rem] border-collapse bg-white text-left text-sm">
            <thead class="bg-emerald-50 text-slate-900">
              <tr>
                <th class="px-4 py-3 font-semibold">Project size</th>
                <th class="px-4 py-3 font-semibold">Price per page</th>
                <th class="px-4 py-3 font-semibold">Example</th>
                <th class="px-4 py-3 font-semibold">Indicative turnaround</th>
              </tr>
            </thead>
            <tbody>
              {pricingTiers.map((tier) => (
                <tr class="border-t border-slate-200">
                  <td class="px-4 py-3 font-medium text-slate-900">{tier.label}</td>
                  <td class="px-4 py-3 text-slate-800">₹{inr(tier.pricePerPage)}</td>
                  <td class="px-4 py-3 text-slate-700">{tier.example.toLocaleString('en-IN')} pages ≈ ₹{inr(tier.example * tier.pricePerPage)}</td>
                  <td class="px-4 py-3 text-slate-700">About {tier.baseDays} working days</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="mt-3 text-xs text-slate-500">Indicative rates, excluding GST. Your confirmed price is in the written proposal.</p>
      </div>
    </section>
  )}

  {extraSections.map((section) => (
    <section class="border-b border-slate-200 bg-white">
      <div class="mx-auto max-w-6xl px-4 py-14">
        <h2 class="text-2xl font-semibold text-slate-900">{section.heading}</h2>
        {(section.paragraphs || []).map((text) => (
          <p class="mt-3 max-w-4xl text-sm leading-7 text-slate-700">{text}</p>
        ))}
        {section.items && section.items.length > 0 && (
          <ul class="mt-5 grid gap-3 sm:grid-cols-2">
            {section.items.map((item) => (
              <li class="rounded-2xl bg-slate-50 p-4 text-sm leading-6 text-slate-700 ring-1 ring-slate-200">{item}</li>
            ))}
          </ul>
        )}
      </div>
    </section>
  ))}

  <section class="border-b border-slate-200 bg-white">
    <div class="mx-auto max-w-6xl px-4 py-14">
      <div class="max-w-3xl">
        <h2 class="text-2xl font-semibold text-slate-900">{hd.industries}</h2>
        <p class="mt-3 text-sm leading-7 text-slate-700">
          Tyrus supports India-wide digitization programs for organizations that manage large paper archives, sensitive records, or recurring scanning requirements.
        </p>
      </div>
      <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {industries.map((item) => (
          <div class="rounded-2xl bg-slate-50 p-5 text-sm font-semibold text-slate-900 ring-1 ring-slate-200">{item}</div>
        ))}
      </div>
    </div>
  </section>

  <section class="border-b border-slate-200 bg-slate-50">
    <div class="mx-auto max-w-6xl px-4 py-14">
      <h2 class="text-2xl font-semibold text-slate-900">{hd.faq}</h2>
      <div class="mt-6 space-y-4">
        {faqs.map(([question, answer]) => (
          <details class="rounded-2xl bg-white p-5 ring-1 ring-slate-200">
            <summary class="cursor-pointer text-sm font-semibold text-slate-900">{question}</summary>
            <p class="mt-3 text-sm leading-7 text-slate-700">{answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-gradient-to-b from-white to-emerald-50" id="quote">
    <div class="mx-auto grid max-w-6xl gap-8 px-4 py-14 lg:grid-cols-[0.9fr,1.1fr] lg:items-start">
      <div>
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-emerald-700">Free project review</p>
        <h2 class="mt-2 text-2xl font-semibold text-slate-900">Plan your project: {serviceType}</h2>
        <p class="mt-3 text-sm leading-7 text-slate-700">
          Share page volume, record type, location, deadline and the output you need. A Tyrus project lead will suggest the scanning model, indexing format and delivery schedule, with a written per-page price.
        </p>
        <ul class="mt-5 space-y-2 text-sm text-slate-700">
          <li>✓ Reply within one working day</li>
          <li>✓ Onsite or offsite options across India</li>
          <li>✓ NDA-backed staff and secure handover</li>
        </ul>
        <a href="/#cost-calculator" class="mt-5 inline-block text-sm font-semibold text-emerald-700 underline">Or try the instant cost calculator</a>
      </div>
      <LeadForm formId={formId} heading={hd.form} context={`Service page: ${serviceType}`} />
    </div>
  </section>
</DefaultLayout>
